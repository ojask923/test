# ==============================================================================
# Simple Local Chatbot Configuration
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Default LLM Provider: "groq", "ollama" (local free), "openai", "gemini", "anthropic"
DEFAULT_PROVIDER=groq

# Default Model Name (provider specific)
# - groq: "openai/gpt-oss-120b", "llama-3.3-70b-versatile", "mixtral-8x7b-32768"
# - ollama: "llama3.2", "mistral", "deepseek-r1:latest", "qwen2.5"
# - openai: "gpt-4o-mini", "gpt-4o"
# - gemini: "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.0-flash"
# - anthropic: "claude-3-5-sonnet-20241022", "claude-3-5-haiku-20241022"
DEFAULT_MODEL=openai/gpt-oss-120b

# Temperature (0.0 to 1.0)
TEMPERATURE=0.7

# API Keys (Optional - only needed if using cloud providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Local Configuration (if using Ollama on your PC)
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Local SQLite (Default - zero setup required, creates local chatbot.db)
DATABASE_URL=sqlite:///./chatbot.db

# Option 2: PostgreSQL (Docker, Local Postgres, Neon, Supabase, etc.)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_db

# Enable Tools (Calculator, Search, Time, etc.)
ENABLE_TOOLS=true

# ==============================================================================
# RAG Vector Store & Search
# ==============================================================================
# ENABLE_HYBRID_SEARCH: combines dense (semantic) + sparse (BM25) retrieval
ENABLE_HYBRID_SEARCH=true
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5

# ENABLE_RERANKING: run FlashRank cross-encoder after initial candidate fetch
ENABLE_RERANKING=true
# RERANK_CANDIDATE_K: how many candidates to fetch before reranking (20-50 recommended)
RERANK_CANDIDATE_K=20
# RERANK_TOP_K: final chunks sent to the LLM after reranking
RERANK_TOP_K=5
# RERANK_MODEL: FlashRank cross-encoder model name
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# ==============================================================================
# RAG Grounding & Citations
# ==============================================================================
# When enabled, retrieved documents are returned with [Doc N] markers and the
# LLM receives citation rules (don't fabricate, say "not found" if missing).
RAG_GROUNDING_ENABLED=true
